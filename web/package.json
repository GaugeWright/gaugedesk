{
  "name": "gaugedesk-web",
  "version": "0.4.5",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "GaugeDesk \u2014 the Solid 1.x projection-first island.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:open": "vite build --config vite.open.config.ts",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build:apps:open": "vite build --config vite.apps.open.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:open-client": "tsc --noEmit -p tsconfig.open-client.json",
    "typecheck:workbench-web": "tsc --noEmit -p tsconfig.workbench-web.json",
    "typecheck:workbench-ui": "tsc --noEmit -p tsconfig.workbench-ui.json",
    "typecheck:mobile-client": "tsc --noEmit -p tsconfig.mobile-client.json",
    "typecheck:embed-client": "tsc --noEmit -p tsconfig.embed-client.json",
    "typecheck:split": "npm run typecheck:open-client && npm run typecheck:workbench-web && npm run typecheck:workbench-ui && npm run typecheck:mobile-client && npm run typecheck:embed-client",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "e2e:live": "GW_E2E_LIVE=1 node e2e/run.mjs",
    "e2e:enterprise": "GW_E2E_COMPOSITION=enterprise node e2e/run.mjs"
  },
  "dependencies": {
    "@git-diff-view/file": "^0.1.5",
    "@git-diff-view/solid": "^0.1.5",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "officeparser": "^7.5.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode-generator": "^2.0.4",
    "solid-js": "^1.9.0"
  },
  "_overrides": "officeparser pins pdfjs-dist at exactly 6.1.200, which GHSA-hq66-cqwq-w95j reports as high severity: a malicious PDF can execute arbitrary JavaScript. Every published officeparser through 7.5.1 pins that same version, so no upgrade resolves it, and `npm audit fix --force` would downgrade officeparser to 6.0.7 and an older pdfjs still. 6.2.108 is the first fixed release and is the same major, which is why forcing it here is safe. Remove this once officeparser ships a pin at or above 6.2.108.",
  "overrides": {
    "officeparser": {
      "pdfjs-dist": "6.2.108"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "fflate": "^0.8.3",
    "playwright-bdd": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.9"
  }
}
