{
  "name": "@gaugewright/mobile-web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "GaugeDesk mobile projection client.",
  "dependencies": {
    "@gaugewright/control-plane-client": "0.0.0",
    "@gaugewright/workbench-ui": "0.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.5",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "solid-js": "^1.9.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./MobileApp": "./src/MobileApp.tsx",
    "./main": "./src/main.tsx",
    "./mobile-control-plane": "./src/mobile-control-plane.ts",
    "./mobile-runtime": "./src/mobile-runtime.ts"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit -p ../../tsconfig.mobile-client.json",
    "build": "vite build --config vite.config.ts"
  },
  "gaugewright": {
    "artifactKind": "app",
    "ciTarget": "npm run typecheck:mobile-client",
    "dependencyPolicy": {
      "mayDependOn": [
        "open-source"
      ],
      "mustNotDependOn": [
        "private-managed-services"
      ]
    },
    "extractionPhase": "monorepo-transitional",
    "licenseTarget": "AGPL-3.0-only",
    "repoTarget": "open-source",
    "sourcePosture": "open-source"
  }
}
