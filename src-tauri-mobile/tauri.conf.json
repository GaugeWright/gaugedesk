{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GaugeDesk",
  "version": "0.4.3",
  "identifier": "com.gaugewright.gaugedesk",
  "build": {
    "frontendDist": "../web/dist-app-mobile-web",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm --prefix ../web run dev --workspace=@gaugewright/mobile-web",
    "beforeBuildCommand": "npm --prefix ../web run build --workspace=@gaugewright/mobile-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GaugeDesk"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: wss: http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": ["mobile"]
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright 2026 GaugeWright",
    "icon": ["../src-tauri/icons/icon.png"],
    "resources": ["PrivacyInfo.xcprivacy"],
    "iOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.ios.plist"
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["gaugewright"],
          "appLink": false
        },
        {
          "scheme": ["https"],
          "host": "desk.gaugewright.com",
          "pathPrefix": ["/link", "/invite"],
          "appLink": true
        }
      ]
    }
  }
}
