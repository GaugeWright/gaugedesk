{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaugewright.com/schemas/product-route-manifest/v1",
  "title": "GaugeWright product route manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owner", "contracts", "exceptions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract" }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    },
    "nonProduct": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonProductOperation" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "authority", "journey", "deployed", "property"],
      "properties": {
        "contract": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "authority": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "journey": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "deployed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "property": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "jurisdiction",
        "transport",
        "method",
        "path",
        "producer",
        "consumer",
        "authentication",
        "scope",
        "capability",
        "requestSchema",
        "responseSchema",
        "sideEffect",
        "risk",
        "compatibility",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "jurisdiction": { "type": "string", "minLength": 1 },
        "transport": {
          "enum": ["http-json", "http-redirect", "http-static", "sse", "websocket", "native-handoff", "internal-callback"]
        },
        "method": {
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "CONNECT"]
        },
        "path": { "type": "string", "pattern": "^/" },
        "producer": { "type": "string", "minLength": 1 },
        "consumer": { "type": "string", "minLength": 1 },
        "authentication": { "type": "string", "minLength": 1 },
        "scope": { "type": ["string", "null"] },
        "capability": { "type": ["string", "null"] },
        "requestSchema": { "type": "string", "minLength": 1 },
        "responseSchema": { "type": "string", "minLength": 1 },
        "sideEffect": {
          "enum": ["none", "session", "mutation", "stream", "redirect", "external"]
        },
        "risk": { "enum": ["critical", "important", "internal", "static-public"] },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractVersion", "minimumConsumer", "maximumConsumer"],
          "properties": {
            "contractVersion": { "type": "integer", "minimum": 1 },
            "minimumConsumer": { "type": "integer", "minimum": 1 },
            "maximumConsumer": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "owner", "reason", "expires"],
      "properties": {
        "method": {
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "CONNECT"]
        },
        "path": { "type": "string", "pattern": "^/" },
        "owner": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "expires": { "type": "string", "format": "date" }
      }
    },
    "nonProductOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "owner", "status", "guard", "reason", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "method": {
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "CONNECT"]
        },
        "path": { "type": "string", "pattern": "^/" },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "const": "test-only" },
        "guard": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
