{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GaugeDesk",
  "version": "0.4.24",
  "identifier": "com.gaugewright.gaugedesk",
  "build": {
    "frontendDist": "../ee/web/dist-enterprise-workbench",
    "devUrl": "http://localhost:5173/apps/enterprise-workbench/",
    "beforeDevCommand": "npm --prefix ../ee/web run dev -- --host localhost --port 5173 --strictPort",
    "beforeBuildCommand": "npm --prefix ../ee/web run build"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "GaugeDesk",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 20 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright 2026 GaugeWright",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "deep-link.desktop",
        "depends": [
          "libc6",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "utils",
        "files": {
          "/usr/share/doc/gaugedesk/changelog.gz": "linux/changelog.gz",
          "/usr/share/doc/gaugedesk/copyright": "linux/copyright"
        },
        "provides": [
          "gauge-bench",
          "gaugebench",
          "gauge-desk"
        ],
        "conflicts": [
          "gauge-bench",
          "gaugebench",
          "gauge-desk"
        ],
        "replaces": [
          "gauge-bench",
          "gaugebench",
          "gauge-desk"
        ]
      }
    },
    "windows": {
      "wix": {
        "upgradeCode": "9deb9a1a-723e-521b-892f-9b4a9d243585"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.gaugewright.com/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxRTQ4RDVCOTE5MUE1NQpSV1JWR2htNTFVZ2VEbnV1eEtCMnlrVFdmeDBDbjdpWGFyQml6LzhDMHNLNDNpUUxrYWwxUy9neAo="
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "gaugewright"
        ]
      }
    }
  }
}
