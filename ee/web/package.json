{
  "name": "gaugedesk-ee-web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "GaugeDesk enterprise workbench composition and enterprise route client.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/enterprise-workbench/vite.config.ts",
    "build": "vite build --config apps/enterprise-workbench/vite.config.ts",
    "postbuild": "node ../../scripts/build-release-identity.mjs",
    "typecheck": "npm run typecheck:enterprise-client && npm run typecheck:enterprise-ui",
    "typecheck:enterprise-client": "tsc --noEmit -p tsconfig.enterprise-client.json",
    "typecheck:enterprise-ui": "tsc --noEmit -p tsconfig.enterprise-ui.json"
  },
  "dependencies": {
    "@gaugewright/control-plane-client": "file:../../web/packages/control-plane-client",
    "@gaugewright/mobile-web": "file:../../web/apps/mobile-web",
    "@gaugewright/workbench-web": "file:../../web/apps/workbench-web",
    "@gaugewright/workbench-ui": "file:../../web/packages/workbench-ui",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^8.1.2",
    "vite-plugin-solid": "^2.11.12"
  }
}
