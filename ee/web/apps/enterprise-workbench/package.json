{
  "name": "@gaugewright/enterprise-workbench",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Capability-gated enterprise composition of the GaugeDesk workbench.",
  "dependencies": {
    "@gaugewright/control-plane-client": "0.0.0",
    "@gaugewright/enterprise-client": "0.0.0",
    "@gaugewright/workbench-web": "0.0.0",
    "@gaugewright/workbench-ui": "0.0.0",
    "solid-js": "^1.9.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./AdminEnvironment": "./src/AdminEnvironment.tsx",
    "./SsoWizard": "./src/SsoWizard.tsx",
    "./main": "./src/main.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ../../tsconfig.enterprise-ui.json",
    "build": "vite build --config vite.config.ts"
  },
  "gaugewright": {
    "artifactKind": "app",
    "ciTarget": "npm run typecheck:enterprise-ui",
    "dependencyPolicy": {
      "mayDependOn": [
        "open-source"
      ],
      "mustNotDependOn": [
        "private-managed-services"
      ]
    },
    "extractionPhase": "monorepo-transitional",
    "licenseTarget": "AGPL-3.0-only",
    "repoTarget": "open-source",
    "sourcePosture": "open-source"
  }
}
