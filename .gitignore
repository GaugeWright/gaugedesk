# Rust backend workspace
/target/

# Docs site build output (mkdocs build → site/)
/site/

# Web island (Solid)
#
# No trailing slash on any node_modules entry: a trailing slash matches
# directories only, and a worktree that symlinks its modules at the main
# checkout — to skip a reinstall — leaves git seeing an untracked *file*.
# `git add -A` would then commit a symlink to an absolute path on one machine.
web/node_modules
web/dist/
web/dist-embed/
web/dist-open/
web/dist-apps-open/
web/dist-app-workbench-web/
web/dist-app-mobile-web/

# Enterprise web workspace (ee/web, SPLIT-2)
ee/web/node_modules
ee/web/dist-apps-enterprise/
ee/web/dist-app-admin-console/
ee/web/dist-enterprise-workbench/

node_modules
src-tauri/linux/changelog.gz
dist/
dist-types/
__pycache__/
**/__pycache__/

# Playwright / playwright-bdd E2E artifacts
web/.features-gen/
web/test-results/
web/playwright-report/
web/blob-report/

# Local control-plane state (git instance + event store)
.gaugewright/
gaugewright.db
# A server launched with a relative local root can materialize its signing key
# beside the enterprise binary crate. Key material is runtime state, never source.
/ee/app/keys/
# Per-boundary whip tracker stores (ADR 0075). Real runs write these under the
# platform data dir; this guards against a relative-root run leaving them in-tree.
trackers/
# legacy data dir (pre-rename), kept ignored so orphaned runtime state stays out of git
.untie/
untie.db
*.db-wal
*.db-shm

# Tauri build artifacts
src-tauri/target/
src-tauri-mobile/target/
src-tauri-mobile/node_modules

# Tauri writes one capability schema per platform it could target, plus the
# platform-family alias. Which per-platform files appear is decided by the host
# that built, so the two a macOS build writes were untracked and unignored and
# dirtied every Mac's tree — while `windows-schema.json` would do the same on
# Windows. Committing them does not fix that: they are byte-identical copies of
# their family alias (`macOS-schema.json` and `linux-schema.json` ARE
# `desktop-schema.json`; `android-schema.json` IS `mobile-schema.json`), so it
# stores the same bytes three times and obliges a machine of each platform to
# regenerate them, which nothing here checks and nothing would notice going
# stale.
#
# The family aliases stay tracked, because `capabilities/*.json` resolve
# `$schema` against them — the same reason the public mirror carries a schema
# alongside the manifest that points at it — and because they do not vary by
# host: a macOS build reproduces the committed, Linux-generated bytes exactly,
# which is why they never appeared as dirty.
src-tauri/gen/schemas/*-schema.json
!src-tauri/gen/schemas/desktop-schema.json
src-tauri-mobile/gen/schemas/*-schema.json
!src-tauri-mobile/gen/schemas/desktop-schema.json
!src-tauri-mobile/gen/schemas/mobile-schema.json

# Release-staged bundle payload (for example a future portable Git tree), never
# committed. WhippleScript is linked into the control plane; Pi is not bundled.
src-tauri/vendor/

# Apalache (TLA+) model-checker output
_apalache-out/

# Claude Code local agent config / state
.claude/

# Cloudflare Wrangler local state (DOCS-1 deploy; regenerable)
.wrangler/

.dev.vars*
!.dev.vars.example
.env*
!.env.example

